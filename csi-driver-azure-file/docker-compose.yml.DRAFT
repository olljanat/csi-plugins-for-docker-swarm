version: "3.10"

services:
  nginx:
    image: nginx
    ports:
      - 8080:80
    volumes:
      - type: cluster
        source: my-csi-driver-azure-file-volume
        target: /usr/share/nginx/html
    networks:
    - nginx

volumes:
  my-csi-driver-azure-file-volume:
    external: true

networks:
  nginx:
